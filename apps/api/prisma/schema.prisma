// G. Inventory
// ============================================================================

model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  movementType  String   @map("movement_type") @db.VarChar(40)
  quantityIn    Decimal  @default(0) @map("quantity_in") @db.Decimal(18, 4)
  quantityOut   Decimal  @default(0) @map("quantity_out") @db.Decimal(18, 4)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(18, 4)
  referenceType String?  @map("reference_type") @db.VarChar(40)
  referenceId   String?  @map("reference_id") @db.Uuid
  notes         String?  @db.Text
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId, productId])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockAdjustment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  adjustmentNumber String   @map("adjustment_number") @db.VarChar(50)
  employeeId       String   @map("employee_id") @db.Uuid
  reason           String   @db.Text
  status           String   @default("DRAFT") @db.VarChar(30)
  approvedBy       String?  @map("approved_by") @db.Uuid
  adjustmentDate   DateTime @default(now()) @map("adjustment_date") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee Employee  @relation("AdjustmentCreator", fields: [employeeId], references: [id], onDelete: Restrict)
  approver Employee? @relation("AdjustmentApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([tenantId, branchId, adjustmentNumber])
  @@index([tenantId])
  @@index([branchId])
  @@map("stock_adjustments")
}

model StockBalance {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, productId])
  @@index([tenantId])
  @@index([branchId])
  @@index([productId])
  @@map("stock_balances")
}

model StockTransfer {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  fromBranchId   String    @map("from_branch_id") @db.Uuid
  toBranchId     String    @map("to_branch_id") @db.Uuid
  transferNumber String    @map("transfer_number") @db.VarChar(50)
  status         String    @default("PENDING") @db.VarChar(30)
  notes          String?   @db.Text
  transferDate   DateTime  @default(now()) @map("transfer_date") @db.Timestamptz(6)
  receivedDate   DateTime? @map("received_date") @db.Timestamptz(6)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch Branch              @relation("TransfersFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch              @relation("TransfersTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  employee   Employee            @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items      StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id          String   @id @default(uuid()) @db.Uuid
  transferId  String   @map("transfer_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Decimal  @db.Decimal(18, 4)
  notes       String?  @db.Text

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

