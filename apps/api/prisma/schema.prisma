model Shift {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  shiftNumber    String    @map("shift_number") @db.VarChar(50)
  openingCash    Decimal   @map("opening_cash") @db.Decimal(18, 2)
  expectedCash   Decimal   @default(0) @map("expected_cash") @db.Decimal(18, 2)
  actualCash     Decimal?  @map("actual_cash") @db.Decimal(18, 2)
  closingCash    Decimal?  @map("closing_cash") @db.Decimal(18, 2)
  cashDifference Decimal?  @map("cash_difference") @db.Decimal(18, 2)
  notes          String?   @db.Text
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  status         String    @default("OPEN") @db.VarChar(30)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  orders   Order[]

  @@unique([tenantId, branchId, shiftNumber])
  @@index([tenantId])
  @@index([branchId])
  @@map("shifts")
}

model ExpenseType {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("expense_types")
}

model Expense {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  expenseTypeId String   @map("expense_type_id") @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  expenseNumber String   @map("expense_number") @db.VarChar(50)
  description   String?  @db.Text
  amount        Decimal  @db.Decimal(18, 2)
  currencyCode  String   @default("USD") @map("currency_code") @db.VarChar(10)
  exchangeRate  Decimal  @default(4100) @map("exchange_rate") @db.Decimal(18, 6)
  paymentMethod String   @map("payment_method") @db.VarChar(40)
  expenseDate   DateTime @default(now()) @map("expense_date") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  expenseType ExpenseType @relation(fields: [expenseTypeId], references: [id], onDelete: Restrict)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, branchId, expenseNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([createdAt])
  @@map("expenses")
}

model Income {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  incomeNumber String   @map("income_number") @db.VarChar(50)
  description  String?  @db.Text
  amount       Decimal  @db.Decimal(18, 2)
  currencyCode String   @default("USD") @map("currency_code") @db.VarChar(10)
  exchangeRate Decimal  @default(4100) @map("exchange_rate") @db.Decimal(18, 6)
  incomeDate   DateTime @default(now()) @map("income_date") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, branchId, incomeNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([createdAt])
  @@map("incomes")
}

// ============================================================================
// I. System Management
// ============================================================================

model Setting {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  settingKey   String   @map("setting_key") @db.VarChar(100)
  settingValue Json     @map("setting_value")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, settingKey])
  @@map("settings")
}

model ExchangeRate {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  baseCurrency   String   @map("base_currency") @db.VarChar(10)
  targetCurrency String   @map("target_currency") @db.VarChar(10)
  rate           Decimal  @db.Decimal(18, 6)
  effectiveAt    DateTime @default(now()) @map("effective_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, baseCurrency, targetCurrency, effectiveAt])
  @@map("exchange_rates")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  employeeId String?  @map("employee_id") @db.Uuid
  action     String   @db.VarChar(80)
  module     String   @db.VarChar(60)
  recordType String   @map("record_type") @db.VarChar(60)
  recordId   String?  @map("record_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(80)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("activity_logs")
}

// ============================================================================
// J. Subscription & Automated Integrations (Version 2)
// ============================================================================

model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  tier         String   @unique @db.VarChar(40)
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  monthlyPrice Decimal  @default(0) @map("monthly_price") @db.Decimal(18, 4)
  yearlyPrice  Decimal  @default(0) @map("yearly_price") @db.Decimal(18, 4)
  maxBranches  Int      @default(1) @map("max_branches")
  maxEmployees Int      @default(3) @map("max_employees")
  maxProducts  Int      @default(500) @map("max_products")
  features     Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @unique @map("tenant_id") @db.Uuid
  planId             String   @map("plan_id") @db.Uuid
  status             String   @default("ACTIVE") @db.VarChar(30)
  billingCycle       String   @default("MONTHLY") @map("billing_cycle") @db.VarChar(20)
  currentPeriodStart DateTime @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime @map("current_period_end") @db.Timestamptz(6)
  autoRenew          Boolean  @default(true) @map("auto_renew")
  paymentMethod      String   @default("BAKONG_KHQR") @map("payment_method") @db.VarChar(50)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices SubscriptionInvoice[]

  @@map("tenant_subscriptions")
}

model SubscriptionInvoice {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  invoiceNumber  String    @unique @map("invoice_number") @db.VarChar(50)
  amount         Decimal   @db.Decimal(18, 4)
  currency       String    @default("USD") @db.VarChar(10)
  status         String    @default("PAID") @db.VarChar(30)
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscription_invoices")
}

model PaymentWebhookLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  gateway    String   @db.VarChar(40)
  event      String   @db.VarChar(60)
  payload    Json
  status     String   @default("PROCESSED") @db.VarChar(30)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([gateway])
  @@map("payment_webhook_logs")
}

