# Root environment reference (copy to apps/api/.env and apps/web/.env.local)

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cambodia_pos?schema=public"

# API Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# JWT Secrets (replace with strong random 32+ char strings in production)
JWT_ACCESS_SECRET="change-this-access-secret-to-at-least-32-characters"
JWT_REFRESH_SECRET="change-this-refresh-secret-to-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

